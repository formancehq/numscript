{
  "$schema": "https://raw.githubusercontent.com/formancehq/numscript/main/v1.specs.schema.json",
  "featureFlags": [
    "experimental-account-interpolation"
  ],
  "testCases": [
    {
      "it": "interpolates a string var",
      "expect.postings": [
        {
          "source": "world",
          "destination": "users:alice:wallet",
          "amount": 10,
          "asset": "USD/2"
        }
      ]
    }
  ]
}

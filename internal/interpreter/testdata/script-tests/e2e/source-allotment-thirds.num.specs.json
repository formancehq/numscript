{
  "$schema": "https://raw.githubusercontent.com/formancehq/numscript/main/v1.specs.schema.json",
  "testCases": [
    {
      "it": "the leftover unit goes to the earliest share",
      "balances": [
        {
          "account": "a",
          "asset": "USD/2",
          "amount": 1000
        },
        {
          "account": "b",
          "asset": "USD/2",
          "amount": 1000
        },
        {
          "account": "c",
          "asset": "USD/2",
          "amount": 1000
        }
      ],
      "expect.postings": [
        {
          "source": "a",
          "destination": "dest",
          "amount": 34,
          "asset": "USD/2"
        },
        {
          "source": "b",
          "destination": "dest",
          "amount": 33,
          "asset": "USD/2"
        },
        {
          "source": "c",
          "destination": "dest",
          "amount": 33,
          "asset": "USD/2"
        }
      ]
    }
  ]
}

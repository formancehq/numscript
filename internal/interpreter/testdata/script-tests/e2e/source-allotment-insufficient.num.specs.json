{
  "$schema": "https://raw.githubusercontent.com/formancehq/numscript/main/v1.specs.schema.json",
  "testCases": [
    {
      "it": "a source that cannot cover its share fails",
      "balances": [
        {
          "account": "s1",
          "asset": "USD/2",
          "amount": 10
        },
        {
          "account": "s2",
          "asset": "USD/2",
          "amount": 1000
        }
      ],
      "expect.error.missingFunds": true
    }
  ]
}

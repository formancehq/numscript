{
  "$schema": "https://raw.githubusercontent.com/formancehq/numscript/main/v1.specs.schema.json",
  "featureFlags": [
    "experimental-overdraft-function"
  ],
  "testCases": [
    {
      "it": "a negative balance's overdraft is the debt",
      "balances": [
        {
          "account": "acc",
          "asset": "USD/2",
          "amount": -100
        }
      ],
      "expect.postings": [
        {
          "source": "world",
          "destination": "dest",
          "amount": 100,
          "asset": "USD/2"
        }
      ]
    },
    {
      "it": "a positive balance has no overdraft",
      "balances": [
        {
          "account": "acc",
          "asset": "USD/2",
          "amount": 100
        }
      ],
      "expect.postings": []
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/formancehq/numscript/main/v1.specs.schema.json",
  "testCases": [
    {
      "it": "splits an amount beyond int64",
      "expect.postings": [
        {
          "source": "world",
          "destination": "a",
          "amount": 500000000000000000000000001,
          "asset": "USD/2"
        },
        {
          "source": "world",
          "destination": "b",
          "amount": 500000000000000000000000000,
          "asset": "USD/2"
        }
      ]
    }
  ]
}

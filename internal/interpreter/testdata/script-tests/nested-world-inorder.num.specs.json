    {
      "it": "world covers the rest from two levels deep, and nothing after it is reached",
      "balances": [
        {
          "account": "a",
          "asset": "COIN",
          "amount": 10
        },
        {
          "account": "b",
          "asset": "COIN",
          "amount": 20
        },
        {
          "account": "never_reached",
          "asset": "COIN",
          "amount": 1000

{
  "$schema": "https://raw.githubusercontent.com/formancehq/numscript/main/v1.specs.schema.json",
  "featureFlags": [
    "experimental-asset-colors"
  ],
  "testCases": [
    {
      "it": "saving the uncolored balance leaves the colored one spendable",
      "balances": [
        {
          "account": "src",
          "asset": "COIN",
          "amount": 100
        },
        {
          "account": "src",
          "asset": "COIN",
          "amount": 50,
          "color": "RED"
        }
      ],
      "expect.postings": [
        {
          "source": "src",
          "destination": "dest",
          "amount": 50,
          "asset": "COIN",
          "color": "RED"
        }
      ]
    }
  ]
}

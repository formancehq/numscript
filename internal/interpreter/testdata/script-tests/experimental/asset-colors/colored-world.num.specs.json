{
  "$schema": "https://raw.githubusercontent.com/formancehq/numscript/main/v1.specs.schema.json",
  "featureFlags": [
    "experimental-asset-colors"
  ],
  "testCases": [
    {
      "it": "an unbounded pull keeps its color",
      "expect.postings": [
        {
          "source": "world",
          "destination": "dest",
          "amount": 30,
          "asset": "COIN",
          "color": "RED"
        },
        {
          "source": "world",
          "destination": "dest",
          "amount": 70,
          "asset": "COIN",
          "color": "BLUE"
        }
      ]
    }
  ]
}

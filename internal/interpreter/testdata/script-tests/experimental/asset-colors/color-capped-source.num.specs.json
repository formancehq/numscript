{
  "$schema": "https://raw.githubusercontent.com/formancehq/numscript/main/v1.specs.schema.json",
  "featureFlags": [
    "experimental-asset-colors"
  ],
  "testCases": [
    {
      "it": "caps the colored pull, then falls back to the uncolored balance",
      "balances": [
        {
          "account": "src",
          "asset": "COIN",
          "amount": 100
        },
        {
          "account": "src",
          "asset": "COIN",
          "amount": 100,
          "color": "RED"
        }
      ],
      "expect.postings": [
        {
          "source": "src",
          "destination": "dest",
          "amount": 10,
          "asset": "COIN",
          "color": "RED"
        },
        {
          "source": "src",
          "destination": "dest",
          "amount": 20,
          "asset": "COIN"
        }
      ],
      "expect.endBalances": [
        {
          "account": "src",
          "asset": "COIN",
          "amount": 80
        },
        {
          "account": "src",
          "asset": "COIN",
          "amount": 90,
          "color": "RED"
        },
        {
          "account": "dest",
          "asset": "COIN",
          "amount": 20
        },
        {
          "account": "dest",
          "asset": "COIN",
          "amount": 10,
          "color": "RED"
        }
      ]
    }
  ]
}

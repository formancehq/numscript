        {
          "account": "b",
          "asset": "GEM",
          "amount": 30
        },
        {
          "account": "c",
          "asset": "GEM",
          "amount": 100
        }
      ],
      "expect.postings": [
        {
          "source": "b",
          "destination": "dest",
          "amount": 30,
          "asset": "GEM"
        },
        {
          "source": "c",
          "destination": "dest",
          "amount": 70,
          "asset": "GEM"
        }
      ]
    }
  ]
}
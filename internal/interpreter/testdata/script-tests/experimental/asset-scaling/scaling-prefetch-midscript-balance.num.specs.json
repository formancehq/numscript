{
  "$schema": "https://raw.githubusercontent.com/formancehq/numscript/main/v1.specs.schema.json",
  "featureFlags": [
    "experimental-asset-scaling",
    "experimental-mid-script-function-call"
  ],
  "testCases": [
    {
      "it": "a scaling send does not mask a later balance() read of another asset",
      "balances": [
        {
          "account": "alice",
          "asset": "EUR",
          "amount": 500
        },
        {
          "account": "alice",
          "asset": "USD/2",
          "amount": 1000
        }
      ],
      "expect.txMetadata": [
        {
          "key": "eur",
          "value": "EUR 510"
        },
        {
          "key": "usd",
          "value": "USD/2 900"
        }
      ]
    }
  ]
}
